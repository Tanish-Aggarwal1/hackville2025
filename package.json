{
  "name": "hackville-2025",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test.e2e": "cypress run",
    "test.unit": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@react-spring/web": "^10.1.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "^8.8.15",
    "@ionic/react-router": "^8.8.15",
    "axios": "^1.18.1",
    "ionicons": "^8.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "react-tinder-card": "^1.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitejs/plugin-react": "^6.0.4",
    "cypress": "^15.19.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "comments": {
    "react-router": "Pinned to v5: @ionic/react-router requires react-router ^5.0.1. It cannot move to v6/v7 while Ionic's router is in use.",
    "typescript": "Pinned to v6: typescript-eslint hard-blocks TypeScript 7.0 (typescript-eslint#10940). Move to ^7 once that lands.",
    "overrides": "react-tinder-card 1.6.4 declares stale peers (React <=18, react-spring ^9). Both work fine on React 19 / react-spring 10; the overrides accept the newer versions."
  },
  "overrides": {
    "react-tinder-card": {
      "react": "$react",
      "@react-spring/web": "$@react-spring/web"
    }
  },
  "description": "An Ionic project"
}
